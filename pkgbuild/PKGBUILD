pkgname=readlist
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyboard-first popup for an arXiv reading list kept as a Markdown note'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/readlist "$pkgdir/usr/bin/readlist"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/readlist.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/readlist.svg"
  install -Dm644 "$startdir/readlist.desktop" "$pkgdir/usr/share/applications/readlist.desktop"
}
